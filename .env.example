# ===================================================================
# FOOTY vs HOOPS — Production Environment Variables Template
# Copy this file to .env and configure for your deployment environment.
# NEVER commit your real .env file or API tokens to source control!
# ===================================================================

# Server Port (Default: 8099)
PORT=8099

# Environment Mode: 'production' or 'development'
NODE_ENV=production

# Telegram Bot API Token from @BotFather (e.g. 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
# Required for Telegram Stars digital invoicing & initData signature validation
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Public HTTPS URL of the deployed Telegram Mini App
# Example: https://fvh.yourdomain.com or https://your-server.up.railway.app
TELEGRAM_MINI_APP_URL=https://your-production-domain.com

# Optional: Provider token for payments (Telegram Stars XTR does not require provider token)
STARS_PROVIDER_TOKEN=

# TON Blockchain Recipient Address for TON crypto payments (Mainnet / Testnet)
# Default is the official development receiver
TON_RECIPIENT_ADDRESS=EQBvW8Z5huBkMJYdn30BlgG3mM2N05hpVNeSlfG2L89xAOn3

# Production CORS origin allowlist (comma-separated, or * for all)
# Example: https://web.telegram.org,https://fvh.yourdomain.com
CORS_ORIGIN=*

# Session & JWT secret for signed match completion tokens
SESSION_SECRET=generate_a_random_32_character_secret_here
